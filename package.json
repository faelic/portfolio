{
  "name": "favour-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=desktop-chromium --project=mobile-chromium --project=webkit",
    "test:map-smoke": "playwright test --project=map-smoke",
    "measure:performance": "node scripts/measure-performance.mjs"
  },
  "dependencies": {
    "cuelume": "^0.2.2",
    "maplibre-gl": "^6.17.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "thinking-orbs": "^0.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^31.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^5.1.0"
  }
}
