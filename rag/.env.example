# Server-side only. Never use a VITE_ prefix for provider credentials.
OPENAI_API_KEY=

# Local tools default to APP_ENV=local. Never commit filled-in secrets.
# Production: use Pxxl Secrets with a dedicated production project key.
# APP_ENV=production
# CHAT_ENABLED=false
# Model-generated follow-ups default true locally and false in production.
# Set false for plain-text generation plus the existing curated fallback.
# CHAT_MODEL_FOLLOWUPS=false
# DATABASE_URL=postgresql://runtime-role:password@your-neon-host/neondb?sslmode=verify-full
# RAG_INDEX_MODE=packaged
# Neon owns the ledger; the release image contains the knowledge index.
# RAG_DATA_DIR is only used by local Chroma/SQLite tools, not this production path.
# ALLOWED_HOSTS=rag-api.favourututu.com,127.0.0.1
# ALLOWED_ORIGINS=https://www.favourututu.com,https://favourututu.com
# CHAT_DAILY_MICRO_USD=1000000
# CHAT_MONTHLY_MICRO_USD=10000000
# CHAT_MAX_ACTIVE_PER_IP=2
# CHAT_IDENTITY_SECRET=<generate a stable cryptographically random secret, at least 32 bytes>
# TRUSTED_PROXY_CIDRS=<verified TCP proxy peer IPs/CIDRs only; empty for direct connections>
# PORT=8000
